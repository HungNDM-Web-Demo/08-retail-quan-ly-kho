# Sao chép file này thành .env (không commit .env)

# ===== Database =====
# Postgres (mặc định, dùng migration) | Sqlite (demo mang đi, không cần cài gì) | SqlServer (chỉ khi khách yêu cầu)
# SQLite và SQL Server tạo bảng bằng EnsureCreated, không dùng migration.
DB_PROVIDER=Postgres
CONNECTION_STRING=Host=localhost;Port=5432;Database=WebDemo_RetailQuanLyKho;Username=postgres;Password=postgres
# Với Sqlite (file tạo trong src/API/App_Data):
# DB_PROVIDER=Sqlite
# CONNECTION_STRING=Data Source=App_Data/retail-quan-ly-kho.db
# Với SqlServer (vd SQL Express: Server=localhost\SQLEXPRESS):
# DB_PROVIDER=SqlServer
# CONNECTION_STRING=Server=localhost;Database=WebDemo_RetailQuanLyKho;Trusted_Connection=True;TrustServerCertificate=True

# ===== JWT =====
# JWT_KEY tối thiểu 32 ký tự; script tạo dự án tự sinh khóa ngẫu nhiên
JWT_KEY=doi-thanh-chuoi-ngau-nhien-toi-thieu-32-ky-tu
JWT_ISSUER=retail-quan-ly-kho
JWT_AUDIENCE=retail-quan-ly-kho
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ===== CORS =====
CORS_ORIGINS=http://localhost:3108

# ===== Demo =====
# true: bật /api/demo/*, nạp dữ liệu mẫu nghiệp vụ khi DB chưa có, tự đặt lại theo DEMO_RESET_CRON.
# Tạo bảng/migration và seed quyền, vai trò, tài khoản demo luôn chạy lúc khởi động.
DEMO_MODE=true
# Mật khẩu chung của tài khoản demo admin / quanly / nhanvien
DEMO_PASSWORD=Demo@123
# Lịch tự đặt lại dữ liệu (cron 5 trường, giờ Việt Nam), để trống để tắt. Ví dụ 3h sáng mỗi ngày:
DEMO_RESET_CRON=0 3 * * *
